# Environment Configuration for Project HIPL

# Application Settings
APP_NAME=Project HIPL
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
FRONTEND_PORT=5173

# Database Configuration
DATABASE_URL=mysql+pymysql://hipl_user:HIPL_SecurePass2026@localhost:3306/hipl_db
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=hipl_db
DATABASE_USER=hipl_user
DATABASE_PASSWORD=HIPL_SecurePass2026
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# N8N Configuration
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@hemrajgroup.com
SMTP_FROM_NAME=Hemraj Group - HIPL

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
HTTPS_ONLY=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# Excel Integration
EXCEL_UPLOAD_PATH=uploads/excel
EXCEL_MAX_FILE_SIZE=10485760

# File Upload
UPLOAD_PATH=uploads
MAX_UPLOAD_SIZE=52428800

# API Documentation
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Timezone
TIMEZONE=Asia/Kolkata

# Features
ENABLE_AUDIT_LOGGING=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_WORKFLOW_MONITORING=true
